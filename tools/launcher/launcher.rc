#include <winver.h>

1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "CoopSummoners (fan project)"
      VALUE "FileDescription", "CoopSummoners launcher"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "CoopSummoners"
      VALUE "LegalCopyright", "MIT License. Not affiliated with Lizsoft or Carpe Fulgur."
      VALUE "OriginalFilename", "CoopSummoners.exe"
      VALUE "ProductName", "CoopSummoners"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
